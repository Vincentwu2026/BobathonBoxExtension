{
  "name": "box-productivity-suite",
  "version": "1.0.0",
  "description": "Enterprise AI Box MCP Server with SQLite FTS5 Indexing and Collaborator-Aware Retention Guard",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "box-productivity-suite": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.scripts.json && tsc -p tsconfig.tests.json && (chmod +x build/index.js 2>/dev/null || true)",
    "start": "node build/index.js",
    "test": "tsc -p tsconfig.tests.json && node build/tests/smoke-test.js",
    "get-tokens": "node build/scripts/get-tokens.js",
    "schedule-crawl": "node build/scripts/schedule-crawl.js",
    "seed-sample-drive": "node build/scripts/seed-sample-drive.js",
    "demo-server": "node build/demo/index.js",
    "web-api": "node build/api/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "clean": "rm -rf build"
  },
  "keywords": [
    "box",
    "mcp",
    "model-context-protocol",
    "ai",
    "fts5",
    "sqlite",
    "retention-guard",
    "enterprise"
  ],
  "author": "Enterprise AI Solutions",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "box-node-sdk": "^10.18.0",
    "fflate": "^0.8.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.24",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
